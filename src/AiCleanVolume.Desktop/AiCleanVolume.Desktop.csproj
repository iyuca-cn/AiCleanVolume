<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>AiCleanVolume</AssemblyName>
    <RootNamespace>AiCleanVolume.Desktop</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <NativeBridgePlatform>x64</NativeBridgePlatform>
    <NativeBridgeProject>$(MSBuildThisFileDirectory)..\AiCleanVolume.NativeBridge\AiCleanVolume.NativeBridge.vcxproj</NativeBridgeProject>
    <NativeBridgeOutputDirectory>$(MSBuildThisFileDirectory)bin\$(NativeBridgePlatform)\$(Configuration)\$(TargetFramework)</NativeBridgeOutputDirectory>
    <NativeBridgeIntermediateDirectory>$(MSBuildThisFileDirectory)..\AiCleanVolume.NativeBridge\obj\$(NativeBridgePlatform)\$(Configuration)\$(TargetFramework)</NativeBridgeIntermediateDirectory>
    <NativeBridgeOutput>$(NativeBridgeOutputDirectory)\AiCleanVolume.NativeBridge.dll</NativeBridgeOutput>
    <NativeBridgeTargetFrameworkVersion Condition="'$(TargetFramework)' == 'net40'">v4.0</NativeBridgeTargetFrameworkVersion>
    <NativeBridgeTargetFrameworkVersion Condition="'$(TargetFramework)' == 'net48'">v4.8</NativeBridgeTargetFrameworkVersion>
    <MftScanCoreProject Condition="'$(MftScanCoreProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\folder-size-ranker-cli\mftscan-core.vcxproj</MftScanCoreProject>
    <NativeBridgeMSBuildPath Condition="'$(NativeBridgeMSBuildPath)' == '' and Exists('F:\Microsoft Visual Studio\18\Insiders\MSBuild\Current\Bin\MSBuild.exe')">F:\Microsoft Visual Studio\18\Insiders\MSBuild\Current\Bin\MSBuild.exe</NativeBridgeMSBuildPath>
    <NativeBridgeMSBuildPath Condition="'$(NativeBridgeMSBuildPath)' == '' and Exists('D:\vs\2022\Community\MSBuild\Current\Bin\MSBuild.exe')">D:\vs\2022\Community\MSBuild\Current\Bin\MSBuild.exe</NativeBridgeMSBuildPath>
    <NativeBridgeMSBuildPath Condition="'$(NativeBridgeMSBuildPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\MSBuild.exe</NativeBridgeMSBuildPath>
    <NativeBridgeMSBuildPath Condition="'$(NativeBridgeMSBuildPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\BuildTools\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\2022\BuildTools\MSBuild\Current\Bin\MSBuild.exe</NativeBridgeMSBuildPath>
    <NativeBridgeMSBuildPath Condition="'$(NativeBridgeMSBuildPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe</NativeBridgeMSBuildPath>
    <NativeBridgeMSBuildPath Condition="'$(NativeBridgeMSBuildPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\MSBuild.exe</NativeBridgeMSBuildPath>
  </PropertyGroup>

  <Target Name="BuildNativeBridgeBeforeResolveReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(NativeBridgeMSBuildPath)' == ''" Text="未找到 Visual Studio MSBuild，无法自动构建 AiCleanVolume.NativeBridge。请安装 VS 2022 C++ 生成工具，或通过 /p:NativeBridgeMSBuildPath=... 指定 MSBuild.exe。" />
    <PropertyGroup Condition="'$(TargetFramework)' == 'net40' and '$(NativeBridgeFrameworkPathOverride)' == '' and '$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net40)' != ''">
      <NativeBridgeFrameworkPathOverride>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net40)\build\.NETFramework\v4.0</NativeBridgeFrameworkPathOverride>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net48' and '$(NativeBridgeFrameworkPathOverride)' == '' and '$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)' != ''">
      <NativeBridgeFrameworkPathOverride>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8</NativeBridgeFrameworkPathOverride>
    </PropertyGroup>
    <Exec Condition="Exists('$(MftScanCoreProject)')" Command="&quot;$(NativeBridgeMSBuildPath)&quot; &quot;$(MftScanCoreProject)&quot; /t:Build /p:Configuration=$(Configuration) /p:Platform=$(NativeBridgePlatform) /m" />
    <Exec Condition="'$(NativeBridgeFrameworkPathOverride)' != ''" Command="&quot;$(NativeBridgeMSBuildPath)&quot; &quot;$(NativeBridgeProject)&quot; /t:Build /p:Configuration=$(Configuration) /p:Platform=$(NativeBridgePlatform) /p:TargetFrameworkVersion=$(NativeBridgeTargetFrameworkVersion) /p:FrameworkPathOverride=$(NativeBridgeFrameworkPathOverride) /p:OutDir=$(NativeBridgeOutputDirectory)\ /p:IntDir=$(NativeBridgeIntermediateDirectory)\ /m" />
    <Exec Condition="'$(NativeBridgeFrameworkPathOverride)' == ''" Command="&quot;$(NativeBridgeMSBuildPath)&quot; &quot;$(NativeBridgeProject)&quot; /t:Build /p:Configuration=$(Configuration) /p:Platform=$(NativeBridgePlatform) /p:TargetFrameworkVersion=$(NativeBridgeTargetFrameworkVersion) /p:OutDir=$(NativeBridgeOutputDirectory)\ /p:IntDir=$(NativeBridgeIntermediateDirectory)\ /m" />
    <Error Condition="!Exists('$(NativeBridgeOutput)')" Text="AiCleanVolume.NativeBridge 构建完成后仍未找到输出：$(NativeBridgeOutput)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AiCleanVolume.Core\AiCleanVolume.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="RestSharp" Version="106.15.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AiCleanVolume.NativeBridge">
      <HintPath>$(NativeBridgeOutput)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Tools\IObitUnlocker\IObitUnlockerCLI.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Tools\IObitUnlocker\IObitUnlocker.sys">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Tools\IObitUnlocker\IObitUnlocker.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="WebUi\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
